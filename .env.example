# XTrace Memory credentials. Both values are required by the SDK.
XTRACE_API_KEY=xtk_replace_me
XTRACE_ORG_ID=org_replace_me

# Google GenAI / Vertex-backed Gemini API key. Keep this server-side only.
GOOGLE_CLOUD_API_KEY=replace_me
GEMINI_API_KEY=replace_me
GEMINI_AGENT_MODEL=gemini-3.5-flash
GEMINI_EXTRACT_MODEL=gemini-3.1-flash-lite

# Demo namespace. Change USER_ID to isolate memory between demos.
HOME_MEMORY_USER_ID=home-demo
HOME_MEMORY_APP_ID=replacemywife-home-memory
HOME_MEMORY_MIN_SCORE=0.35
NEXT_PUBLIC_APP_NAME=Replace My Wife: Home Memory
